{
  "name": "collabrix-next",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "tsx server.ts",
    "test": "npm test --workspace=backend",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.55.0"
  }
}
